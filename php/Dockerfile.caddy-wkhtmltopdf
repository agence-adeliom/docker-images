# syntax=docker/dockerfile:1
ARG PHP_VERSION
ARG REGISTRY
ARG TAG_VERSION
ARG CADDY_VERSION="2.11.4"
# Build from source instead of copying the official caddy image's binary: the
# official image lags behind on Go toolchain patch releases (e.g. it still
# ships go1.26.3, which is vulnerable to CVE-2026-39821, fixed in go1.26.6),
# even when the Caddy version itself hasn't changed. Building against a
# current `golang` image lets us pick up stdlib security patches immediately.
FROM golang:1.26-alpine AS caddy-builder
ARG CADDY_VERSION
ENV CGO_ENABLED=0
# golang:1.26-alpine still ships go1.26.8, which is vulnerable to the Go stdlib
# CVEs fixed in go1.26.9 / go1.26.10 (e.g. CVE-2026-56857, CVE-2026-78663,
# CVE-2026-111943). Let the Go command fetch the fixed toolchain until the
# golang image catches up; drop this line once `golang:1.26-alpine` >= 1.26.10.
ENV GOTOOLCHAIN=go1.26.10
# xcaddy (rather than a plain `go install`) builds Caddy the way upstream
# recommends: as a dependency of a generated main module, which is what lets
# `caddy version` resolve its own version/checksum via Go's build info.
RUN apk add --no-cache git \
    && go install github.com/caddyserver/xcaddy/cmd/xcaddy@latest
WORKDIR /build
# Caddy v2.11.4's own go.mod still pins golang.org/x/crypto v0.52.0 and
# google.golang.org/grpc v1.81.0, which lag behind fixes for
# CVE-2026-78662 (x/crypto/ssh DoS), CVE-2026-84304 / GHSA-hrxh-6v49-42gf
# (grpc-go DoS / auth bypass) and CVE-2026-84445 (grpc-go xDS server panic
# DoS via missing :authority/Host headers, fixed in grpc-go v1.83.2) and
# CVE-2026-78663 (HTTP/2 server double flow-control refund, memory-limit
# bypass, fixed in x/net v0.60.0; Caddy v2.11.4 pins x/net v0.58.0),
# CVE-2026-63209 (klauspost/compress integer overflow, fixed in v1.18.7),
# CVE-2026-116587 (go-jose DoS, fixed in v4.1.6) and CVE-2026-114437 (go-chi
# chi, fixed in v5.4.0). Force newer, non-plugin dependency versions via
# `--replace` until upstream Caddy bumps them itself.
# Not forced on purpose: github.com/google/cel-go >= 0.29.0 (GHSA-gcjh-h69q-9w9g)
# breaks Caddy v2.11.4's CEL matcher at compile time, and the otel log modules
# (CVE-2026-81871 / CVE-2026-81872, fixed in v0.21.0) are too tightly coupled to
# bump individually; both need an upstream Caddy release.
RUN xcaddy build "v${CADDY_VERSION}" \
    --replace golang.org/x/crypto=golang.org/x/crypto@v0.56.0 \
    --replace golang.org/x/net=golang.org/x/net@v0.60.0 \
    --replace google.golang.org/grpc=google.golang.org/grpc@v1.83.2 \
    --replace github.com/klauspost/compress=github.com/klauspost/compress@v1.18.7 \
    --replace github.com/go-jose/go-jose/v4=github.com/go-jose/go-jose/v4@v4.1.6 \
    --replace github.com/go-chi/chi/v5=github.com/go-chi/chi/v5@v5.4.0 \
    && mv /build/caddy /usr/bin/caddy

FROM ${REGISTRY}/php:${PHP_VERSION}-fpm-wkhtmltopdf${TAG_VERSION}

LABEL org.opencontainers.image.source=https://github.com/agence-adeliom/docker-images/tree/main/php
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.authors="Adeliom https://adeliom.com"
LABEL org.opencontainers.image.title="PHP ${PHP_VERSION} - Caddy - wkhtmltopdf"
LABEL org.opencontainers.image.description="PHP ${PHP_VERSION} Docker image with Caddy and wkhtmltopdf"

RUN set -eux; \
	mkdir -p \
		/config/caddy \
		/data/caddy \
		/etc/caddy \
		/usr/share/caddy \
	;

COPY --from=caddy-builder /usr/bin/caddy /usr/bin/caddy

RUN set -x \
	&& apk --update add --no-cache supervisor \
		ca-certificates \
		mailcap \
		nss-tools \
	&& rm  -rf /tmp/* /var/cache/apk/*

ENV XDG_CONFIG_HOME="/config"
ENV XDG_DATA_HOME="/data"

ENV SERVER_NAME=":80"
ENV DOCUMENT_ROOT="/var/www/html/"

EXPOSE 80
EXPOSE 443
EXPOSE 443/udp
EXPOSE 2019

WORKDIR /var/www/html/
VOLUME ["/etc/caddy", "/config/caddy", "/data/caddy", "/var/www/html"]

COPY config/caddy/Caddyfile /etc/caddy/
COPY config/supervisord.conf /etc/
COPY config/supervisord/caddy.conf /etc/supervisord/
COPY config/supervisord/php-fpm.conf /etc/supervisord/

COPY config/caddy/docker-entrypoint.sh /usr/local/bin/docker-entrypoint
RUN chmod +x /usr/local/bin/docker-entrypoint

STOPSIGNAL SIGQUIT

ENTRYPOINT ["docker-entrypoint"]
CMD ["-D"]
