# syntax=docker/dockerfile:1
ARG PHP_VERSION
ARG REGISTRY
ARG TAG_VERSION
ARG CADDY_VERSION="2.11.4"
# Build from source instead of copying the official caddy image's binary: the
# official image lags behind on Go toolchain patch releases (e.g. it still
# ships go1.26.3, which is vulnerable to CVE-2026-39821, fixed in go1.26.6),
# even when the Caddy version itself hasn't changed. Building against a
# current `golang` image lets us pick up stdlib security patches immediately.
FROM golang:1.26-alpine AS caddy-builder
ARG CADDY_VERSION
ENV CGO_ENABLED=0
RUN go install "github.com/caddyserver/caddy/v2/cmd/caddy@v${CADDY_VERSION}"
RUN mv /go/bin/caddy /usr/bin/caddy

FROM ${REGISTRY}/php:${PHP_VERSION}-fpm-wkhtmltopdf${TAG_VERSION}

LABEL org.opencontainers.image.source=https://github.com/agence-adeliom/docker-images/tree/main/php
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.authors="Adeliom https://adeliom.com"
LABEL org.opencontainers.image.title="PHP ${PHP_VERSION} - Caddy - wkhtmltopdf"
LABEL org.opencontainers.image.description="PHP ${PHP_VERSION} Docker image with Caddy and wkhtmltopdf"

RUN set -eux; \
	mkdir -p \
		/config/caddy \
		/data/caddy \
		/etc/caddy \
		/usr/share/caddy \
	;

COPY --from=caddy-builder /usr/bin/caddy /usr/bin/caddy

RUN set -x \
	&& apk --update add --no-cache supervisor \
		ca-certificates \
		mailcap \
		nss-tools \
	&& rm  -rf /tmp/* /var/cache/apk/*

ENV XDG_CONFIG_HOME="/config"
ENV XDG_DATA_HOME="/data"

ENV SERVER_NAME=":80"
ENV DOCUMENT_ROOT="/var/www/html/"

EXPOSE 80
EXPOSE 443
EXPOSE 443/udp
EXPOSE 2019

WORKDIR /var/www/html/
VOLUME ["/etc/caddy", "/config/caddy", "/data/caddy", "/var/www/html"]

COPY config/caddy/Caddyfile /etc/caddy/
COPY config/supervisord.conf /etc/
COPY config/supervisord/caddy.conf /etc/supervisord/
COPY config/supervisord/php-fpm.conf /etc/supervisord/

COPY config/caddy/docker-entrypoint.sh /usr/local/bin/docker-entrypoint
RUN chmod +x /usr/local/bin/docker-entrypoint

STOPSIGNAL SIGQUIT

ENTRYPOINT ["docker-entrypoint"]
CMD ["-D"]
